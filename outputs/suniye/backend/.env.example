PORT=8787
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FAMILY_TOKEN=
# OpenAI-compatible Gemma vision server (Ollama locally; vLLM on a GPU for hosting).
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_ID=gemma3:4b
MODEL_API_KEY=
# Use ollama locally for structured JSON and model timing; openai for compatible hosted endpoints.
MODEL_PROTOCOL=openai
MODEL_KEEP_ALIVE=10m
ELEVENLABS_API_KEY=
# Preferred voice: Raju - Clear, Natural and Warm (zT03pEAEi0VHKciJODfn), selected after listening.
# Its API succeeded with the redeemed Hacktoberfest Creator offer on October 3.
# Leave the ID empty until API access succeeds on your account.
# Use an Indian Hindi voice whose accent has passed a listening check.
# language_code=hi does not make an American preset native Hindi.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
# Supported here: eleven_v4, eleven_v4_turbo, eleven_multilingual_v2.
# The v4 free web/mobile promotion does not cover API calls; API uses account credits.
MONGODB_URI=
SENTRY_DSN=

# Optional developer-only comparison: six synthetic text calls, no automatic retries.
BACKBOARD_API_KEY=
# JSON array: [{"provider":"from model library","model":"open-weight model ID","weightsSource":"official model-card URL"}, {...}]
BACKBOARD_COMPARE_MODELS=[]

# Use 1 only for a short synthetic tracing demonstration.
SENTRY_SAMPLE_RATE=0.2

# Developer/caregiver only: two public official-support searches plus Gemma summary.
SERPAPI_API_KEY=
